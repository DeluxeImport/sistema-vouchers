# Token del bot, generado con @BotFather (/newbot). Nunca lo subas al repo.
TELEGRAM_BOT_TOKEN=

# Base de la API de Sistema Vouchers. En produccion, la URL real del backend.
API_BASE_URL=http://localhost:3000/api

# Debe ser EXACTAMENTE el mismo valor que BOT_SERVICE_TOKEN en backend/.env
# del repo sistema-vouchers (es el secreto compartido entre ambos servicios).
BOT_SERVICE_TOKEN=

# Lista blanca de chat_id de grupos desde donde el bot acepta fotos,
# separados por coma (ej: -1001234567890,-1009876543210).
# Vacio = acepta de cualquier chat (solo para pruebas locales).
CHAT_IDS_PERMITIDOS=
