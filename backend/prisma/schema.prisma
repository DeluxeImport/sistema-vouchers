generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String    @id
  nombre               String
  username             String    @unique
  passwordHash         String    @map("password_hash")
  rol                  String    @default("USUARIO")
  // CSV de categorias permitidas. null = todas (admin). Vacio = ninguna.
  categoriasPermitidas String?   @map("categorias_permitidas") @db.Text
  puedeSubir           Boolean   @default(true) @map("puede_subir")
  puedeVerGaleria      Boolean   @default(true) @map("puede_ver_galeria")
  puedeVerDashboard    Boolean   @default(true) @map("puede_ver_dashboard")
  puedeDescargar       Boolean   @default(true) @map("puede_descargar")
  debeCambiar          Boolean   @default(true) @map("debe_cambiar")
  totpSecret           String?   @map("totp_secret")
  totpActivo           Boolean   @default(false) @map("totp_activo")
  backupCodes          String?   @map("backup_codes") @db.Text
  intentosFallidos     Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta       DateTime? @map("bloqueado_hasta")
  ultimoAcceso         DateTime? @map("ultimo_acceso")
  creadoEn             DateTime  @default(now()) @map("creado_en")
  actualizado          DateTime  @updatedAt @map("actualizado")
  // Cuenta de Telegram vinculada (bot de registro automatico). null = no vinculada.
  telegramUserId       String?   @unique @map("telegram_user_id")

  vouchers          Voucher[]
  sesiones          Sesion[]
  auditLogs         AuditLog[]
  tokensVinculacion TokenVinculacion[]

  @@map("usuarios")
}

model Voucher {
  voucherId     String    @id @map("voucher_id")
  usuarioId     String    @map("usuario_id")
  // Categoria contable (o una categoria anterior en vouchers historicos).
  categoria     String
  // null = voucher (sustento de pago). NOTA / FACTURA / BOLETA = documento.
  tipoDocumento String?   @map("tipo_documento")
  nombreArchivo String    @map("nombre_archivo")
  rutaArchivo   String    @map("ruta_archivo") @db.VarChar(500)
  tamanoBytes   Int?      @map("tamano_bytes")
  formato       String?
  fechaCarga    DateTime  @default(now()) @map("fecha_carga")
  // Fecha real del voucher (puede diferir de la fecha de subida) y nota libre.
  fechaVoucher  DateTime? @map("fecha_voucher")
  descripcion   String?   @db.Text
  // Papelera (soft delete): null = activo. Si tiene fecha, esta en papelera y
  // se borra definitivamente a los 15 dias.
  eliminadoEn   DateTime? @map("eliminado_en")
  ipCarga       String?   @map("ip_carga")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([categoria])
  @@index([tipoDocumento])
  @@index([usuarioId])
  @@index([eliminadoEn])
  @@map("vouchers")
}

model Contador {
  categoria    String @id
  ultimoNumero Int    @default(0) @map("ultimo_numero")

  @@map("contadores")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  usuarioId String?  @map("usuario_id")
  accion    String
  ip        String?
  userAgent String?  @map("user_agent") @db.Text
  detalles  String?  @db.Text
  timestamp DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("audit_log")
}

model Sesion {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  tokenHash String   @map("token_hash")
  ip        String?
  userAgent String?  @map("user_agent") @db.Text
  expiraEn  DateTime @map("expira_en")
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sesiones")
}

// Token de un solo uso para vincular una cuenta con el bot de Telegram
// (boton "Vincular Telegram" en el perfil -> deep link t.me/<Bot>?start=TOKEN).
model TokenVinculacion {
  token     String   @id
  usuarioId String   @map("usuario_id")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("tokens_vinculacion")
}

// Grupos de Telegram registrados desde donde el bot puede recibir comprobantes.
// Solo informativo (area/centro de costo para reportes); NO filtra categorias,
// eso depende unicamente de los permisos del usuario que sube la foto.
model GrupoTelegram {
  chatId           String   @id @map("chat_id")
  areaOCentroCosto String   @map("area_o_centro_costo")
  creadoEn         DateTime @default(now()) @map("creado_en")

  @@map("grupos_telegram")
}
